{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://3d-floorplan.local/schemas/asset-catalog-2.0.json",
  "title": "3D Floorplan Asset Catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "mobileBudgetBytes", "sources", "assets", "roomRecipes"],
  "properties": {
    "schemaVersion": {"const": "2.0"},
    "id": {"$ref": "#/$defs/id"},
    "version": {"type": "integer", "minimum": 1},
    "mobileBudgetBytes": {"type": "integer", "minimum": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "assets": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/asset"}},
    "roomRecipes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["living", "dining", "bedroom"],
      "properties": {
        "living": {"$ref": "#/$defs/recipe"},
        "dining": {"$ref": "#/$defs/recipe"},
        "bedroom": {"$ref": "#/$defs/recipe"}
      }
    }
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positiveVector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "number", "exclusiveMinimum": 0},
        {"type": "number", "exclusiveMinimum": 0}
      ]
    },
    "vector3": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [{"type": "number"}, {"type": "number"}, {"type": "number"}]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "siteVersion", "embeddedVersion", "author", "sourceUrl", "downloadUrl", "sha256", "license"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "name": {"type": "string", "minLength": 1},
        "siteVersion": {"type": "string", "minLength": 1},
        "embeddedVersion": {"type": "string", "minLength": 1},
        "author": {"type": "string", "minLength": 1},
        "sourceUrl": {"type": "string", "format": "uri"},
        "downloadUrl": {"type": "string", "format": "uri"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["spdx", "url", "localNotice"],
          "properties": {
            "spdx": {"const": "CC0-1.0"},
            "url": {"type": "string", "format": "uri"},
            "localNotice": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "fallback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "materialRole"],
      "properties": {
        "kind": {"enum": ["box", "cylinder", "sphere"]},
        "materialRole": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"}
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "bytes"],
      "properties": {
        "url": {"type": "string", "pattern": "^/catalog-assets/models/[a-z0-9-]+\\.glb$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1, "maximum": 3145728}
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "roomTypes", "canonicalSize", "fallback"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["model", "procedural"]},
        "roomTypes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["living", "dining", "bedroom", "other"]}
        },
        "sourceId": {"$ref": "#/$defs/id"},
        "sourceEntry": {"type": "string", "minLength": 1},
        "sourceSha256": {"$ref": "#/$defs/sha256"},
        "sourceMaterialSha256": {"$ref": "#/$defs/sha256"},
        "canonicalSize": {"$ref": "#/$defs/positiveVector3"},
        "materialMode": {"enum": ["replace", "tint", "preserve"]},
        "delivery": {"$ref": "#/$defs/delivery"},
        "fallback": {"$ref": "#/$defs/fallback"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "model"}}},
          "then": {"required": ["sourceId", "sourceEntry", "sourceSha256", "delivery"]},
          "else": {
            "not": {
              "anyOf": [
                {"required": ["sourceId"]},
                {"required": ["sourceEntry"]},
                {"required": ["sourceSha256"]},
                {"required": ["sourceMaterialSha256"]},
                {"required": ["delivery"]}
              ]
            }
          }
        }
      ]
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "itemId", "assetId", "role", "collisionMode", "position", "rotationYDegrees"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "itemId": {"$ref": "#/$defs/id"},
        "assetId": {"$ref": "#/$defs/id"},
        "role": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,31}$"},
        "collisionMode": {"enum": ["solid", "surface"]},
        "position": {"$ref": "#/$defs/vector3"},
        "size": {"$ref": "#/$defs/positiveVector3"},
        "rotationYDegrees": {"type": "number", "minimum": -360, "maximum": 360}
      }
    },
    "recipe": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/placement"}}
  }
}
